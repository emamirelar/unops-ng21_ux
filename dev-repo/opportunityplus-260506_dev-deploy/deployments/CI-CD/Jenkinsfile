properties(
    [
        buildDiscarder(logRotator(numToKeepStr: "8"))
    ]
)

timestamps {
    def branchName = env.BRANCH_NAME ?: 'test'
    def agentLabel = "opportunityplus-agent-${branchName}"

    echo "Using Jenkins dynamic agent: ${agentLabel}"
    
node(agentLabel) {
    def CHECK_NAME = 'Jenkins CI'
    def BUILD_URL = env.BUILD_URL ?: ''

    def environment, PROJECT_ID, REPO_NAME, IMAGE_NAME_MAIN, IMAGE_NAME_AI, IMAGE_TAG
    def SERVICE_NAME_MAIN, SERVICE_NAME_AI, REGION, SQL_CONN_STRING, VPC_CONNECTOR
    def SECRETS_MAIN, ENV_VARS_AI, CREDENTIALS_ID, DOCKERFILE_MAIN, PORT_MAIN, PORT_AI
    def AI_MIN_INSTANCES, AI_MAX_INSTANCES, AI_MEMORY, AI_CPU, AI_CONCURRENCY, INVOKER_SERVICE_ACCOUNTS_MAIN, INVOKER_SERVICE_ACCOUNTS_AI
    def MAIN_MIN_INSTANCES, MAIN_MAX_INSTANCES, MAIN_MEMORY, MAIN_CPU, MAIN_CONCURRENCY
    def DB_SECRET_NAME

    try {
        stage('Checkout Code') {
            def checkoutSuccess = false
            def maxAttempts = 3
            def lastError = null

            for (int attempt = 1; attempt <= maxAttempts; attempt++) {
                try {
                    echo "Checkout attempt ${attempt} of ${maxAttempts}..."
                    checkout([
                        $class: 'GitSCM',
                        branches: scm.branches,
                        doGenerateSubmoduleConfigurations: false,
                        extensions: [
                            [$class: 'CloneOption',
                             depth: 0,
                             noTags: false,
                             reference: '',
                             shallow: false,
                             timeout: 5],
                            [$class: 'SubmoduleOption',
                             disableSubmodules: false,
                             parentCredentials: true,
                             recursiveSubmodules: true,
                             reference: '',
                             timeout: 5,
                             trackingSubmodules: false]
                        ],
                        submoduleCfg: [],
                        userRemoteConfigs: scm.userRemoteConfigs
                    ])
                    checkoutSuccess = true
                    echo "Checkout succeeded on attempt ${attempt}"
                    break
                } catch (Exception checkoutError) {
                    lastError = checkoutError
                    echo "Checkout attempt ${attempt} failed: ${checkoutError.getMessage()}"
                    if (attempt < maxAttempts) {
                        def waitSeconds = attempt * 15
                        echo "Waiting ${waitSeconds} seconds before retry..."
                        sleep(waitSeconds)
                        // Clean workspace before retry to avoid partial clone issues
                        sh 'git clean -fdx || true'
                        sh 'git submodule foreach --recursive git clean -fdx || true'
                    }
                }
            }

            if (!checkoutSuccess) {
                error("Checkout failed after ${maxAttempts} attempts. Last error: ${lastError?.getMessage() ?: 'Unknown'}")
            }

            publishChecks name: CHECK_NAME,
                          status: 'IN_PROGRESS',
                          title: 'Build Started',
                          summary: "Starting build for branch: ${env.BRANCH_NAME ?: 'development'}",
                          detailsURL: BUILD_URL
        }
        
        stage('Load Configuration') {
            def configYaml = readFile('deployments/CI-CD/jenkins-config.yaml')
            def yaml = new org.yaml.snakeyaml.Yaml()
            def config = yaml.load(configYaml)

            def currentBranch = env.BRANCH_NAME ?: 'development'
            def envConfig = null
 
            config.environments.each { envName, envSettings -> 
                if (currentBranch.matches(envSettings.branch_pattern)) {
                    envConfig = envSettings
                    return true
                }
            }

            if (!envConfig) {
                envConfig = config.environments.development
                echo "No matching environment found for branch ${currentBranch}, using development environment"
            }
            
            environment = envConfig.environment
            PROJECT_ID = envConfig.project_id
            REPO_NAME = envConfig.repo_name
            IMAGE_NAME_MAIN = envConfig.image_name_main
            IMAGE_NAME_AI = envConfig.image_name_ai
            IMAGE_TAG = 'latest'
            SERVICE_NAME_MAIN = envConfig.service_name_main
            SERVICE_NAME_AI = envConfig.service_name_ai
            REGION = envConfig.region
            SQL_CONN_STRING = envConfig.sql_conn_string
            VPC_CONNECTOR = envConfig.vpc_connector
            SECRETS_MAIN = envConfig.secrets_main
            ENV_VARS_AI = envConfig.env_vars_ai
            CREDENTIALS_ID = envConfig.credentials_id
            DOCKERFILE_MAIN = envConfig.dockerfile_main
            PORT_MAIN = envConfig.port_main
            PORT_AI = envConfig.port_ai
            AI_MIN_INSTANCES = envConfig.ai_min_instances
            AI_MAX_INSTANCES = envConfig.ai_max_instances
            AI_MEMORY = envConfig.ai_memory
            AI_CPU = envConfig.ai_cpu
            AI_CONCURRENCY = envConfig.ai_concurrency
            MAIN_MIN_INSTANCES = envConfig.main_min_instances
            MAIN_MAX_INSTANCES = envConfig.main_max_instances
            MAIN_MEMORY = envConfig.main_memory
            MAIN_CPU = envConfig.main_cpu
            MAIN_CONCURRENCY = envConfig.main_concurrency
            INVOKER_SERVICE_ACCOUNTS_MAIN = envConfig.invoker_service_accounts_main
            INVOKER_SERVICE_ACCOUNTS_AI = envConfig.invoker_service_accounts_ai
            DB_SECRET_NAME = envConfig.db_secret_name

            echo "Configuration loaded for environment: ${environment}"
            echo "Project ID: ${PROJECT_ID}"
            echo "Branch: ${currentBranch}"
            echo "Main Service Scaling: ${MAIN_MIN_INSTANCES}-${MAIN_MAX_INSTANCES} instances, ${MAIN_MEMORY} memory, ${MAIN_CPU} cpu, ${MAIN_CONCURRENCY} concurrency"
            echo "AI Service Scaling: ${AI_MIN_INSTANCES}-${AI_MAX_INSTANCES} instances, ${AI_MEMORY} memory, ${AI_CPU} cpu, ${AI_CONCURRENCY} concurrency"
            echo "Main Service Invoker Accounts: ${INVOKER_SERVICE_ACCOUNTS_MAIN}"
            echo "AI Service Invoker Accounts: ${INVOKER_SERVICE_ACCOUNTS_AI}"
        }

        stage('Ensure Artifact Registry Exists') {
            // Isolated CLOUDSDK_CONFIG avoids stale active account (e.g. GCE metadata) on reused dynamic agents.
            // Backoff retries cover transient metadata/API failures.
            def registryReady = false
            def maxAttempts = 4
            def lastError = null

            for (int attempt = 1; attempt <= maxAttempts; attempt++) {
                try {
                    echo "Ensure Artifact Registry attempt ${attempt} of ${maxAttempts}..."
                    withCredentials([file(credentialsId: CREDENTIALS_ID, variable: 'GOOGLE_APPLICATION_CREDENTIALS')]) {
                        sh """
                        set -e
                        UNIQUE_CREDS_FILE="\${WORKSPACE}/gcp-creds-registry-\${BUILD_NUMBER}.json"
                        GCLOUD_CONFIG="\${WORKSPACE}/gcloud-config-registry-\${BUILD_NUMBER}"
                        cp "\${GOOGLE_APPLICATION_CREDENTIALS}" "\${UNIQUE_CREDS_FILE}"
                        mkdir -p "\${GCLOUD_CONFIG}"
                        export CLOUDSDK_CONFIG="\${GCLOUD_CONFIG}"
                        export GOOGLE_APPLICATION_CREDENTIALS="\${UNIQUE_CREDS_FILE}"
                        # Prefer key file for token operations (reduces mistaken metadata refresh on CI agents)
                        export CLOUDSDK_AUTH_CREDENTIAL_FILE_OVERRIDE="\${UNIQUE_CREDS_FILE}"

                        gcloud auth activate-service-account --key-file="\${UNIQUE_CREDS_FILE}"
                        CLIENT_EMAIL=\$(sed -n 's/.*"client_email"[[:space:]]*:[[:space:]]*"\\([^"]*\\)".*/\\1/p' "\${UNIQUE_CREDS_FILE}" | head -1)
                        gcloud config set account "\${CLIENT_EMAIL}"
                        gcloud config set project ${PROJECT_ID}

                        REPO_TYPE="docker"
                        REGISTRY_OK=false
                        for inner in 1 2 3; do
                            if gcloud artifacts repositories describe "${REPO_NAME}" --location="${REGION}" >/dev/null 2>&1; then
                                echo "Artifact Registry '${REPO_NAME}' already exists in '${REGION}'."
                                REGISTRY_OK=true
                                break
                            fi
                            echo "Registry missing or describe failed (attempt \$inner/3); creating '${REPO_NAME}'..."
                            if gcloud artifacts repositories create "${REPO_NAME}" \\
                                --repository-format="\$REPO_TYPE" \\
                                --location="${REGION}" \\
                                --description="Docker repository for cloud run images"; then
                                echo "Created Artifact Registry '${REPO_NAME}' in '${REGION}'."
                                REGISTRY_OK=true
                                break
                            fi
                            # Create may fail if another job created the repo, or due to flake — confirm with describe
                            if gcloud artifacts repositories describe "${REPO_NAME}" --location="${REGION}" >/dev/null 2>&1; then
                                echo "Artifact Registry '${REPO_NAME}' exists in '${REGION}' (created concurrently or already present)."
                                REGISTRY_OK=true
                                break
                            fi
                            if [ \$inner -lt 3 ]; then
                                echo "Waiting 15s before retrying registry describe/create..."
                                sleep 5
                            fi
                        done
                        if [ "\$REGISTRY_OK" != true ]; then
                            echo "Artifact Registry ensure failed after inner retries"
                            exit 1
                        fi

                        rm -f "\${UNIQUE_CREDS_FILE}"
                        rm -rf "\${GCLOUD_CONFIG}"
                        """
                    }
                    registryReady = true
                    echo "Ensure Artifact Registry succeeded on attempt ${attempt}"
                    break
                } catch (Exception registryError) {
                    lastError = registryError
                    echo "Ensure Artifact Registry attempt ${attempt} failed: ${registryError.getMessage()}"
                    if (attempt < maxAttempts) {
                        def waitSeconds = attempt * 20
                        echo "Waiting ${waitSeconds} seconds before outer retry..."
                        sleep(waitSeconds)
                    }
                }
            }

            if (!registryReady) {
                error("Ensure Artifact Registry failed after ${maxAttempts} attempts. Last error: ${lastError?.getMessage() ?: 'Unknown'}")
            }
        }

        stage('Pre-Deploy: Drop BQ Compatible Views') {
            if (environment in ['Test', 'Production']) {
            withCredentials([file(credentialsId: CREDENTIALS_ID, variable: 'GOOGLE_APPLICATION_CREDENTIALS')]) {
                sh """
                UNIQUE_CREDS_FILE="\${WORKSPACE}/gcp-creds-db-pre-\${BUILD_NUMBER}.json"
                cp "\${GOOGLE_APPLICATION_CREDENTIALS}" "\${UNIQUE_CREDS_FILE}"
                gcloud auth activate-service-account --key-file="\${UNIQUE_CREDS_FILE}"
                gcloud config set project ${PROJECT_ID}

                # Fetch and parse credentials silently — set +x prevents password appearing in logs
                set +x
                DB_CONN_STRING=\$(gcloud secrets versions access latest --secret="${DB_SECRET_NAME}" --project="${PROJECT_ID}")
                DB_NAME=\$(echo "\$DB_CONN_STRING" | tr ';' '\\n' | grep -i '^Database=' | cut -d'=' -f2-)
                DB_USER=\$(echo "\$DB_CONN_STRING" | tr ';' '\\n' | grep -iE '^(Username|User Id)=' | cut -d'=' -f2-)
                DB_PASS=\$(echo "\$DB_CONN_STRING" | tr ';' '\\n' | grep -i '^Password=' | cut -d'=' -f2-)
                # PGPASSWORD (not .pgpass): passwords may contain ':' and '\\' which break .pgpass field parsing
                export PGPASSWORD="\$DB_PASS"
                set -x
                echo "Pre-deploy: dropping BQ compatible views from PAO database: \${DB_NAME}"

                # Download Cloud SQL Auth Proxy if not available on the agent
                if command -v cloud-sql-proxy &>/dev/null; then
                    PROXY_BIN=\$(command -v cloud-sql-proxy)
                else
                    PROXY_BIN="/tmp/cloud-sql-proxy-\${BUILD_NUMBER}"
                    wget -q https://storage.googleapis.com/cloud-sql-connectors/cloud-sql-proxy/v2.13.0/cloud-sql-proxy.linux.amd64 -O "\${PROXY_BIN}"
                    chmod +x "\${PROXY_BIN}"
                fi

                # Start Cloud SQL Auth Proxy pointing to the PAO Cloud SQL instance (private IP only)
                "\${PROXY_BIN}" --credentials-file="\${UNIQUE_CREDS_FILE}" --port 5433 --private-ip "${SQL_CONN_STRING}" &
                PROXY_PID=\$!
                sleep 8

                # Write DROP SQL to a temp file to avoid shell escaping issues with dollar-quoted strings
                SQL_FILE="/tmp/drop_bq_views_\${BUILD_NUMBER}.sql"
                cat > "\${SQL_FILE}" << 'ENDSQL'
DO \$\$
DECLARE
  r record;
BEGIN
  FOR r IN
    SELECT table_schema, table_name
    FROM information_schema.views
    WHERE table_schema = 'bq_data_transfer'
  LOOP
    EXECUTE 'DROP VIEW IF EXISTS ' || quote_ident(r.table_schema) || '.' || quote_ident(r.table_name) || ' CASCADE';
    RAISE NOTICE 'Dropped view: %.%', r.table_schema, r.table_name;
  END LOOP;
END \$\$;
ENDSQL

                psql -h 127.0.0.1 -p 5433 -U "\${DB_USER}" -d "\${DB_NAME}" -f "\${SQL_FILE}"
                echo "BQ compatible views dropped successfully (or none existed)"

                # Cleanup
                kill \$PROXY_PID || true
                wait \$PROXY_PID 2>/dev/null || true
                set +x
                unset PGPASSWORD
                set -x
                rm -f "\${SQL_FILE}" "\${UNIQUE_CREDS_FILE}"
                echo "\${PROXY_BIN}" | grep -q '/tmp/' && rm -f "\${PROXY_BIN}" || true
                """
            }
            } else {
                echo "Skipping Pre-Deploy BQ stage — not applicable for environment: ${environment}"
            }
        }

        stage('Build and Deploy Services') {
            parallel(
                "Main Application": {
                    withCredentials([file(credentialsId: CREDENTIALS_ID, variable: 'GOOGLE_APPLICATION_CREDENTIALS')]) {
                        sh """
                        # Create isolated build directory for Main application
                        MAIN_BUILD_DIR="\${WORKSPACE}/main-build-\${BUILD_NUMBER}"
                        mkdir -p "\${MAIN_BUILD_DIR}"
                        
                        # Copy all source files to isolated directory
                        rsync -a --exclude="main-build-*" --exclude="ai-build-*" . "\${MAIN_BUILD_DIR}/"
                        
                        cd "\${MAIN_BUILD_DIR}"
                        
                        # Setup unique credentials
                        UNIQUE_CREDS_FILE="\${MAIN_BUILD_DIR}/gcp-creds-main-\${BUILD_NUMBER}.json"
                        cp "\${GOOGLE_APPLICATION_CREDENTIALS}" "\${UNIQUE_CREDS_FILE}"
                        gcloud auth activate-service-account --key-file="\${UNIQUE_CREDS_FILE}"
                        gcloud config set project ${PROJECT_ID}
                        
                        # Copy the appropriate Dockerfile
                        cp deployments/Docker/${DOCKERFILE_MAIN} Dockerfile
                        
                        # Build and push main application image (with retry for transient GCP API issues)
                        BUILD_SUCCESS=false
                        for attempt in 1 2 3; do
                            echo "Build attempt \$attempt for main application..."
                            if gcloud builds submit --tag europe-west4-docker.pkg.dev/${PROJECT_ID}/${IMAGE_NAME_MAIN}:${IMAGE_TAG} .; then
                                echo "Main application build successful on attempt \$attempt"
                                BUILD_SUCCESS=true
                                break
                            else
                                echo "Main application build failed on attempt \$attempt"
                                if [ \$attempt -lt 3 ]; then
                                    echo "Waiting 20 seconds before retry..."
                                    sleep 20
                                fi
                            fi
                        done
                        if [ "\$BUILD_SUCCESS" = false ]; then
                            echo "Main application build failed after 3 attempts"
                            exit 1
                        fi

                        # Deploy main application to Cloud Run with retry logic
                        echo "Deploying main application to Cloud Run..."
                        DEPLOY_SUCCESS=false
                        for attempt in 1 2 3; do
                            echo "Deployment attempt \$attempt for main application..."
                            if gcloud run deploy ${SERVICE_NAME_MAIN} \\
                                    --image europe-west4-docker.pkg.dev/${PROJECT_ID}/${IMAGE_NAME_MAIN}:${IMAGE_TAG} \\
                                    --project ${PROJECT_ID} \\
                                    --region ${REGION} \\
                                    --port ${PORT_MAIN} \\
                                    --platform managed \\
                                    --use-http2 \\
                                    --set-cloudsql-instances ${SQL_CONN_STRING} \\
                                    --vpc-connector ${VPC_CONNECTOR} \\
                                    --vpc-egress private-ranges-only \\
                                    --set-env-vars ASPNETCORE_ENVIRONMENT=${environment} \\
                                    --set-secrets ${SECRETS_MAIN} \\
                                    --min-instances ${MAIN_MIN_INSTANCES} \\
                                    --max-instances ${MAIN_MAX_INSTANCES} \\
                                    --memory ${MAIN_MEMORY} \\
                                    --cpu ${MAIN_CPU} \\
                                    --timeout=900 \\
                                    --concurrency=${MAIN_CONCURRENCY} \\
                                    --quiet; then
                                echo "Main application deployment successful on attempt \$attempt"
                                DEPLOY_SUCCESS=true
                                break
                            else
                                echo "Main application deployment failed on attempt \$attempt"
                                if [ \$attempt -lt 3 ]; then
                                    echo "Waiting 30 seconds before retry..."
                                    sleep 30
                                fi
                            fi
                        done
                        
                        if [ "\$DEPLOY_SUCCESS" = false ]; then
                            echo "Main application deployment failed after 3 attempts"
                            exit 1
                        fi
                        
                        # Configure IAM policies for main service
                        echo "Setting up Cloud Run invoker permissions for main service..."
                        IFS=',' read -ra ADDR <<< "${INVOKER_SERVICE_ACCOUNTS_MAIN}"
                        for service_account in "\${ADDR[@]}"; do
                            echo "Granting Cloud Run invoker role to \$service_account for main service..."
                            gcloud run services add-iam-policy-binding ${SERVICE_NAME_MAIN} \\
                                --member="serviceAccount:\$service_account" \\
                                --role="roles/run.invoker" \\
                                --region=${REGION} \\
                                --project=${PROJECT_ID} || echo "Warning: Failed to set IAM policy for main service"
                        done
                        
                        # Cleanup
                        rm -f "\${UNIQUE_CREDS_FILE}"
                        cd "\${WORKSPACE}"
                        rm -rf "\${MAIN_BUILD_DIR}"
                        """
                    }
                },
                "AI Service": {
                    withCredentials([file(credentialsId: CREDENTIALS_ID, variable: 'GOOGLE_APPLICATION_CREDENTIALS')]) {
                        sh """
                        # Create isolated build directory for AI service
                        AI_BUILD_DIR="\${WORKSPACE}/ai-build-\${BUILD_NUMBER}"
                        mkdir -p "\${AI_BUILD_DIR}"
                        
                        # Copy all source files to isolated directory
                        rsync -a --exclude="main-build-*" --exclude="ai-build-*" . "\${AI_BUILD_DIR}/"
                        
                        cd "\${AI_BUILD_DIR}"
                        
                        # Setup unique credentials
                        UNIQUE_CREDS_FILE="\${AI_BUILD_DIR}/gcp-creds-ai-\${BUILD_NUMBER}.json"
                        cp "\${GOOGLE_APPLICATION_CREDENTIALS}" "\${UNIQUE_CREDS_FILE}"
                        gcloud auth activate-service-account --key-file="\${UNIQUE_CREDS_FILE}"
                        gcloud config set project ${PROJECT_ID}
                        
                        # Copy AIService configuration files into the AI service directory
                        cp -r AIService UNOPS.PAO.AIService/
                        
                        # Navigate to AI service directory
                        cd UNOPS.PAO.AIService

                        # Build and push AI service image (with retry for transient GCP API issues)
                        BUILD_SUCCESS=false
                        for attempt in 1 2 3; do
                            echo "Build attempt \$attempt for AI service..."
                            if gcloud builds submit --tag europe-west4-docker.pkg.dev/${PROJECT_ID}/${IMAGE_NAME_AI}:${IMAGE_TAG} .; then
                                echo "AI service build successful on attempt \$attempt"
                                BUILD_SUCCESS=true
                                break
                            else
                                echo "AI service build failed on attempt \$attempt"
                                if [ \$attempt -lt 3 ]; then
                                    echo "Waiting 20 seconds before retry..."
                                    sleep 20
                                fi
                            fi
                        done
                        if [ "\$BUILD_SUCCESS" = false ]; then
                            echo "AI service build failed after 3 attempts"
                            exit 1
                        fi

                        # Deploy AI service to Cloud Run with retry logic
                        echo "Deploying AI service to Cloud Run..."
                        DEPLOY_SUCCESS=false
                        for attempt in 1 2 3; do
                            echo "Deployment attempt \$attempt for AI service..."
                            if gcloud run deploy ${SERVICE_NAME_AI} \\
                                    --image europe-west4-docker.pkg.dev/${PROJECT_ID}/${IMAGE_NAME_AI}:${IMAGE_TAG} \\
                                    --project ${PROJECT_ID} \\
                                    --region ${REGION} \\
                                    --port ${PORT_AI} \\
                                    --platform managed \\
                                    --set-cloudsql-instances ${SQL_CONN_STRING} \\
                                    --vpc-connector ${VPC_CONNECTOR} \\
                                    --vpc-egress private-ranges-only \\
                                    --set-env-vars ${ENV_VARS_AI} \\
                                    --min-instances ${AI_MIN_INSTANCES} \\
                                    --max-instances ${AI_MAX_INSTANCES} \\
                                    --memory ${AI_MEMORY} \\
                                    --cpu ${AI_CPU} \\
                                    --timeout=900 \\
                                    --concurrency=${AI_CONCURRENCY} \\
                                    --quiet; then
                                echo "AI service deployment successful on attempt \$attempt"
                                DEPLOY_SUCCESS=true
                                break
                            else
                                echo "AI service deployment failed on attempt \$attempt"
                                if [ \$attempt -lt 3 ]; then
                                    echo "Waiting 30 seconds before retry..."
                                    sleep 30
                                fi
                            fi
                        done
                        
                        if [ "\$DEPLOY_SUCCESS" = false ]; then
                            echo "AI service deployment failed after 3 attempts"
                            exit 1
                        fi
                        
                        # Configure IAM policies for AI service
                        echo "Setting up Cloud Run invoker permissions for AI service..."
                        IFS=',' read -ra ADDR <<< "${INVOKER_SERVICE_ACCOUNTS_AI}"
                        for service_account in "\${ADDR[@]}"; do
                            echo "Granting Cloud Run invoker role to \$service_account for AI service..."
                            gcloud run services add-iam-policy-binding ${SERVICE_NAME_AI} \\
                                --member="serviceAccount:\$service_account" \\
                                --role="roles/run.invoker" \\
                                --region=${REGION} \\
                                --project=${PROJECT_ID} || echo "Warning: Failed to set IAM policy for AI service"
                        done
                        
                        # Cleanup
                        rm -f "\${UNIQUE_CREDS_FILE}"
                        cd "\${WORKSPACE}"
                        rm -rf "\${AI_BUILD_DIR}"
                        """
                    }
                }
            )
        }
        
        stage('Post-Deploy: Recreate BQ Compatible Views') {
            if (environment in ['Test', 'Production']) {
            withCredentials([file(credentialsId: CREDENTIALS_ID, variable: 'GOOGLE_APPLICATION_CREDENTIALS')]) {
                sh """
                UNIQUE_CREDS_FILE="\${WORKSPACE}/gcp-creds-db-post-\${BUILD_NUMBER}.json"
                cp "\${GOOGLE_APPLICATION_CREDENTIALS}" "\${UNIQUE_CREDS_FILE}"
                gcloud auth activate-service-account --key-file="\${UNIQUE_CREDS_FILE}"
                gcloud config set project ${PROJECT_ID}

                # Fetch and parse credentials silently — set +x prevents password appearing in logs
                set +x
                DB_CONN_STRING=\$(gcloud secrets versions access latest --secret="${DB_SECRET_NAME}" --project="${PROJECT_ID}")
                DB_NAME=\$(echo "\$DB_CONN_STRING" | tr ';' '\\n' | grep -i '^Database=' | cut -d'=' -f2-)
                DB_USER=\$(echo "\$DB_CONN_STRING" | tr ';' '\\n' | grep -iE '^(Username|User Id)=' | cut -d'=' -f2-)
                DB_PASS=\$(echo "\$DB_CONN_STRING" | tr ';' '\\n' | grep -i '^Password=' | cut -d'=' -f2-)
                # PGPASSWORD (not .pgpass): passwords may contain ':' and '\\' which break .pgpass field parsing
                export PGPASSWORD="\$DB_PASS"
                set -x
                echo "Post-deploy: applying functions/SP and recreating BQ compatible views in PAO database: \${DB_NAME}"

                # Download Cloud SQL Auth Proxy if not available on the agent
                if command -v cloud-sql-proxy &>/dev/null; then
                    PROXY_BIN=\$(command -v cloud-sql-proxy)
                else
                    PROXY_BIN="/tmp/cloud-sql-proxy-\${BUILD_NUMBER}"
                    wget -q https://storage.googleapis.com/cloud-sql-connectors/cloud-sql-proxy/v2.13.0/cloud-sql-proxy.linux.amd64 -O "\${PROXY_BIN}"
                    chmod +x "\${PROXY_BIN}"
                fi

                # Start Cloud SQL Auth Proxy pointing to the PAO Cloud SQL instance (private IP only)
                "\${PROXY_BIN}" --credentials-file="\${UNIQUE_CREDS_FILE}" --port 5433 --private-ip "${SQL_CONN_STRING}" &
                PROXY_PID=\$!
                sleep 8

                # Step 1: Ensure bq_data_transfer schema exists
                psql -h 127.0.0.1 -p 5433 -U "\${DB_USER}" -d "\${DB_NAME}" \\
                    -c "CREATE SCHEMA IF NOT EXISTS bq_data_transfer;"

                # Step 2: Drop existing function and SP so appuser can recreate them
                # (they may be owned by a different role from a prior manual deployment)
                echo "Dropping existing bq_data_transfer function and stored procedure..."
                psql -h 127.0.0.1 -p 5433 -U "\${DB_USER}" -d "\${DB_NAME}" \\
                    -c "DROP FUNCTION IF EXISTS bq_data_transfer.get_bq_compatible_view_sql(); DROP PROCEDURE IF EXISTS bq_data_transfer.create_bq_compatible_views();"
                echo "Existing function and stored procedure dropped"

                # Step 3: Deploy helper function (fresh CREATE — owned by appuser)
                echo "Applying bq_data_transfer helper function..."
                psql -h 127.0.0.1 -p 5433 -U "\${DB_USER}" -d "\${DB_NAME}" \\
                    -f "deployments/CI-CD/sql/bq_data_transfer/function - get_bq_compatible_view_sql.sql"
                echo "Helper function applied successfully"

                # Step 4: Deploy stored procedure (fresh CREATE — owned by appuser)
                echo "Applying bq_data_transfer stored procedure..."
                psql -h 127.0.0.1 -p 5433 -U "\${DB_USER}" -d "\${DB_NAME}" \\
                    -f "deployments/CI-CD/sql/bq_data_transfer/stored proc - bq_data_transfer.create_bq_compatible_views.sql"
                echo "Stored procedure applied successfully"

                # Step 5: Call the SP to recreate all BQ-compatible views
                echo "Calling bq_data_transfer.create_bq_compatible_views()..."
                psql -h 127.0.0.1 -p 5433 -U "\${DB_USER}" -d "\${DB_NAME}" \\
                    -c "CALL bq_data_transfer.create_bq_compatible_views();"
                echo "BQ compatible views recreated successfully"

                # Cleanup
                kill \$PROXY_PID || true
                wait \$PROXY_PID 2>/dev/null || true
                set +x
                unset PGPASSWORD
                set -x
                rm -f "\${UNIQUE_CREDS_FILE}"
                echo "\${PROXY_BIN}" | grep -q '/tmp/' && rm -f "\${PROXY_BIN}" || true
                """
            }
            } else {
                echo "Skipping Post-Deploy BQ stage — not applicable for environment: ${environment}"
            }
        }

        stage('Post-Deploy Actions') {
            echo 'Build completed successfully!'
            echo "Main App Service: https://console.cloud.google.com/run/detail/${REGION}/${SERVICE_NAME_MAIN}"
            echo "AI Service: https://console.cloud.google.com/run/detail/${REGION}/${SERVICE_NAME_AI}"
            
            publishChecks name: CHECK_NAME,
                          status: 'COMPLETED',
                          conclusion: 'SUCCESS',
                          title: 'Build Succeeded',
                          summary: "Successfully deployed to ${environment} environment - Main app and AI service deployed",
                          detailsURL: BUILD_URL
        }
    }
    catch (Exception e) {
        def errorMessage = e?.getMessage() ?: 'Unknown error occurred'
        echo "Build failed: ${errorMessage}"
        currentBuild.result = 'FAILURE'
        
        try {
            publishChecks name: CHECK_NAME ?: 'Jenkins CI',
                          status: 'COMPLETED',
                          conclusion: 'FAILURE',
                          title: 'Build Failed',
                          summary: "Build failed: ${errorMessage}",
                          detailsURL: BUILD_URL ?: env.BUILD_URL ?: ''
        } catch (Exception statusError) {
            echo "Could not publish status: ${statusError.getMessage()}"
        }
    }
}
}